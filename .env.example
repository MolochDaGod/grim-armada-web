# Game data SSOT (Railway). Prefer same-origin /api/* rewrites in vercel.json.
VITE_BACKEND_URL=https://grudge-api-production-0d46.up.railway.app

# Auth: id.grudge-studio.com (via /api/auth rewrite)
# Assets: same-origin /models and /textures from public/ (default).
# Only force CDN after R2 is seeded under grim-armada/:
# VITE_FORCE_ASSET_CDN=true
# VITE_ASSET_CDN_URL=https://assets.grudge-studio.com
# VITE_USE_LOCAL_ASSETS=true
# Run locally before first deploy: npm run assets:pipeline
