# Grudge Studio VPS Backend
# Set VITE_BACKEND_URL to point all API calls to the canonical backend
VITE_BACKEND_URL=https://api.grudge-studio.com

# Auth is handled by id.grudge-studio.com
# Game data by api.grudge-studio.com
# WebSocket by ws.grudge-studio.com
# Assets CDN by assets.grudge-studio.com
# VITE_ASSET_CDN_URL=https://assets.grudge-studio.com
# VITE_USE_LOCAL_ASSETS=true
# Run locally before first deploy: npm run assets:pipeline
